# ============================================================
# NIVARA 2.0 — Environment Configuration Example
# Copy this file to .env and configure for live telephony
# ============================================================

# Environment Mode
NIVARA_ENV=development
PORT=8000
HOST=0.0.0.0

# Voice Calling Mode: 'demo' (safe simulation mode) or 'real' (actual outbound telephony)
VOICE_CALL_MODE=demo

# Telephony Provider: 'twilio' or 'mock'
VOICE_PROVIDER=twilio

# Twilio Telephony Credentials (Required only when VOICE_CALL_MODE=real)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Telephony Webhook Base URL (Public URL or ngrok domain for incoming Twilio callbacks)
WEBHOOK_BASE_URL=http://localhost:8000

# Emergency Escalation Parameters
ALERT_MODE=DEMO
ALERT_ACK_TIMEOUT_MINUTES=15
MAX_CALL_ATTEMPTS=2

# Gemini AI Copilot
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
